<div class="container" onswipe="goHome">
    <text class="title" style="width: 240px; font-size: 18px; text-align: center; margin-bottom: 12px;">
        {{ result }}
    </text>

    <input type="button"
           style="width: 240px; margin: 12px 0px; background-color: slateblue; font-size: 18px; height: 44px;
                   border-radius: 8px;" @click="sha256">
        SHA256
    </input>

    <input type="button"
           style="width: 240px; margin: 12px 0px; background-color: slateblue; font-size: 18px; height: 44px;
                   border-radius: 8px;" @click="md5">
        MD5
    </input>

    <input type="button"
           style="width: 240px; margin: 12px 0px; background-color: slateblue; font-size: 18px; height: 44px;
                   border-radius: 8px;" @click="createRandom">
        Random
    </input>
</div>
